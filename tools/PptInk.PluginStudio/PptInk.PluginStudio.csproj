<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PptInk.PluginStudio</AssemblyName>
    <RootNamespace>PptInk.PluginStudio</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 编辑器：Lua 语法高亮 + 行号 -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PptInk.PluginStudio.Core/PptInk.PluginStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/Lua.xshd" />
  </ItemGroup>

</Project>