<Application x:Class="PptInk.PluginStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/WorkbenchWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 统一视觉：浅色、圆角、离手清晰（课堂工具风格） -->
            <SolidColorBrush x:Key="WindowBg" Color="#F6F7F9"/>
            <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Accent" Color="#2E86DE"/>
            <SolidColorBrush x:Key="AccentSoft" Color="#E8F2FC"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
            <SolidColorBrush x:Key="ErrorText" Color="#C0392B"/>
            <SolidColorBrush x:Key="WarnText" Color="#B7791F"/>

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{StaticResource WindowBg}"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="#D9DEE5" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>