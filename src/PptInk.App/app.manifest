<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.1.2.0" name="PptInk.App"/>

  <!-- 以当前用户权限运行：与 PowerPoint 放映进程权限保持一致，
       避免 COM 跨完整性级别调用失败（学校机房常见管理员 PPT + 普通用户工具问题） -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- 86 寸 4K 大屏：PerMonitorV2 DPI，保证物理毫米↔像素映射精确。
       逗号回退链：Win10 1703 之前不识别 PMv2，退 PerMonitor 而不是 unaware。
       （旧式 dpiAware 元素会触发 WinForms 构建目标 WFAC010，DPI 统一走本元素） -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>

  <!-- 声明兼容 Win8.1/Win10/11：Win8.1 GUID 是 WM_POINTER 消息投递资格的保守保险
       （通道 A 原生指针输入——触摸/笔直达 WndProc，不依赖 WPF 触摸栈）；
       同时避免托盘与 WinEvent 钩子在旧版主题下行为异常 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility1">
    <application>
      <supportedOS Id="{1f676c76-80e1-423e-85ab-3701e87c0772}" />
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
